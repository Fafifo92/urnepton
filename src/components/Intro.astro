---
/* Pantalla de entrada: cubre la carga del bundle 3D y capta el gesto
   de usuario que WebAudio necesita para poder sonar. */
---

<div id="intro" role="dialog" aria-label="Bienvenida">
  <div class="intro-inner">
    <div class="intro-orbits" aria-hidden="true">
      <span class="io io-1"></span><span class="io io-2"></span><span class="io io-3"></span>
      <span class="intro-core"></span>
    </div>
    <p class="intro-logo">URNEPTON</p>
    <p class="intro-sub">Un sistema sonoro en órbita</p>
    <div class="intro-progress"><span id="intro-bar"></span></div>
    <div class="intro-actions" hidden>
      <button class="btn btn-solid" id="enter-sound">Entrar con sonido</button>
      <button class="btn btn-ghost" id="enter-silent">Entrar en silencio</button>
    </div>
  </div>
</div>
