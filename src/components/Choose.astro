---
import { SITE } from "../data/site";
import { PLANETS } from "../data/planets";

const planets = [PLANETS.production, PLANETS.post];
---

<section id="choose" class="snap">
  <div class="choose-head reveal">
    <p class="step-pill">Paso 1 de 3 — Elige un planeta</p>
    <p class="kicker">{SITE.chooseKicker}</p>
    <h2>{SITE.chooseTitle}</h2>
    <p class="choose-sub">{SITE.chooseSub}</p>
  </div>

  {/* Escritorio: etiquetas proyectadas en tiempo real sobre los planetas 3D */}
  {
    planets.map((p) => (
      <button class="planet-tag" id={`tag-${p.id}`} data-planet={p.id}>
        <span class="pt-ring" aria-hidden="true" />
        <span class="pt-name">{p.name}</span>
        <span class="pt-line" />
        <span class="pt-cta">Entrar en órbita</span>
      </button>
    ))
  }

  {/* Móvil: tarjetas reales — en pantalla angosta los planetas no caben
      en cuadro y tocar una esfera diminuta es mala experiencia táctil. */}
  <div class="planet-picker">
    {
      planets.map((p) => (
        <button class="planet-card" data-planet={p.id}>
          <span class="pc-orb" style={`--a:${p.accent};--b:${p.accentHot}`} aria-hidden="true" />
          <span class="pc-text">
            <span class="pc-role">{p.role}</span>
            <span class="pc-name">{p.name}</span>
            <span class="pc-tag">{p.tagline}</span>
          </span>
          <span class="pc-go" aria-hidden="true">→</span>
        </button>
      ))
    }
  </div>
</section>
