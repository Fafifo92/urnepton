---
import { SITE } from "../data/site";
---

<section id="hero" class="snap snap-center">
  <div class="hero-content reveal">
    <p class="kicker">{SITE.heroKicker}</p>
    <h1 class="hero-title">{SITE.name}</h1>
    <p class="hero-sub">{SITE.heroSub}</p>
    <div class="scroll-hint" aria-hidden="true">
      <span class="hint-line"></span>
      <span class="hint-text">Desliza para despegar</span>
    </div>
  </div>
</section>
