---
/* Visor de proyecto: embed de YouTube bajo demanda, reproductor de
   audio o ficha de caso. El contenido lo inyecta ui.ts al abrirlo. */
---

<div id="project-modal" hidden>
  <div class="modal-backdrop" data-close></div>
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="pm-title">
    <button class="panel-close" data-close aria-label="Cerrar proyecto">×</button>
    <p class="kicker" id="pm-kicker"></p>
    <h3 id="pm-title"></h3>
    <p class="pm-client" id="pm-client"></p>
    <div class="pm-media" id="pm-media"></div>
    <p class="pm-desc" id="pm-desc"></p>
  </div>
</div>
